<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>KKS_ChaAlphaMask</AssemblyName>
    <RootNamespace>KK_ChaAlphaMask</RootNamespace>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Version>1.1.1</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 游戏目录，可通过 -p:GameDir=... 覆盖 -->
    <GameDir Condition="'$(GameDir)' == ''">E:\game\GDAkk\KoikatuSunshine</GameDir>
    <ManagedDir>$(GameDir)\KoikatsuSunshine_Data\Managed</ManagedDir>
    <CoreDir>$(GameDir)\BepInEx\core</CoreDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\*.cs" />
    <EmbeddedResource Include="..\src\KK_ChaAlphaMask.resources.alphamaskmultiply">
      <LogicalName>KKS_ChaAlphaMask.resources.alphamaskmultiply</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(CoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KKSAPI">
      <HintPath>$(PluginsDir)\KKSAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KKS_OverlayMods">
      <HintPath>$(PluginsDir)\KKS_OverlayMods.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KKS_MaterialEditor">
      <HintPath>$(PluginsDir)\KKS_Plugins\KKS_MaterialEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Force High Poly 是可选依赖，代码里用反射读取，没装也能编译 -->
    <Reference Include="KKS_ForceHighPoly" Condition="Exists('$(PluginsDir)\KKS_Plugins\KKS_ForceHighPoly.dll')">
      <HintPath>$(PluginsDir)\KKS_Plugins\KKS_ForceHighPoly.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KKS_ExtensibleSaveFormat">
      <HintPath>$(PluginsDir)\KKS_BepisPlugins\KKS_ExtensibleSaveFormat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KKS_Sideloader">
      <HintPath>$(PluginsDir)\KKS_BepisPlugins\KKS_Sideloader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(ManagedDir)\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
